# Committed defaults (no secrets -- everything here is public once built,
# since Vite inlines VITE_-prefixed vars into the client bundle).
# Override VITE_SITE_URL in the hosting platform's dashboard for production
# (see issue #26, "Set up production deployment").
VITE_SITE_URL=http://localhost:5173
VITE_API_URL=http://localhost:3000

# Google Places Autocomplete on the admin Settings "Cím" field. Not set here --
# put the real value in .env.local (gitignored) for local dev, and in the
# hosting platform's dashboard (Vercel) for production/preview. Restricted by
# HTTP referrer in Google Cloud Console (currently localhost:5173/*; add the
# production domain there once it's decided).
VITE_GOOGLE_PLACES_API_KEY=

# Plausible analytics -- deliberately unset here. Currently only wired up
# against a self-hosted local instance (see README for the Docker setup);
# put VITE_PLAUSIBLE_DOMAIN and VITE_PLAUSIBLE_API_HOST in .env.local to try
# it locally. Activating it for real production traffic is a later, separate
# decision (just setting these two in the hosting platform's dashboard).
VITE_PLAUSIBLE_DOMAIN=
VITE_PLAUSIBLE_API_HOST=
